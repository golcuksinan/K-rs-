# docker compose degiskenleri (proje kokundeki .env dosyasina kopyalanir).
# Lokal (Docker'siz) calistirma icin backend/.env.example kullanilir.

POSTGRES_USER=kursu
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kursu_db

# openssl rand -hex 32 ile uretilir, ikisi birbirinden farkli olmali.
# EMAIL_PEPPER_KEY asla rotate edilmez: degisirse mevcut email_hash'ler gecersiz kalir.
SECRET_KEY=changeme
EMAIL_PEPPER_KEY=changemetoo

# Prod'da frontend origin'i yazilir, virgulle ayrilir. "*" sadece dev icindir.
ALLOWED_ORIGINS=https://kursu.example.com

HF_API_TOKEN=
HF_MODEL_URL=https://router.huggingface.co/hf-inference/models/unitary/toxic-bert

API_PORT=8000
