# Uygulama ayarlari (backend/.env dosyasina kopyalanir).
# Docker ile calisirken compose bu dosyayi env_file olarak yukler ve DATABASE_URL'i ezer.

# Docker'siz lokal calistirma icin gecerlidir.
DATABASE_URL=postgresql://user:password@localhost:5432/kursu_db

# openssl rand -hex 32 ile uretilir, ikisi birbirinden farkli olmali.
# EMAIL_PEPPER_KEY asla rotate edilmez: degisirse mevcut email_hash'ler gecersiz kalir.
SECRET_KEY=changeme
EMAIL_PEPPER_KEY=changemetoo
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Prod'da frontend origin'i yazilir, virgulle ayrilir. "*" sadece dev icindir.
ALLOWED_ORIGINS=*

HF_API_TOKEN=
HF_MODEL_URL=https://router.huggingface.co/hf-inference/models/unitary/toxic-bert

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=5

# Reverse proxy'lerin IP'leri, virgulle ayrilir. Bos = X-Forwarded-For'a guvenilmez.
TRUSTED_PROXY_IPS=
