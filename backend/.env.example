# Uygulama ayarlari (backend/.env dosyasina kopyalanir).
# Docker ile calisirken compose bu dosyayi env_file olarak yukler ve DATABASE_URL'i ezer.

# Docker'siz lokal calistirma icin gecerlidir.
DATABASE_URL=postgresql://user:password@localhost:5432/kursu_db

# openssl rand -hex 32 ile uretilir, ikisi birbirinden farkli olmali.
# EMAIL_PEPPER_KEY asla rotate edilmez: degisirse mevcut email_hash'ler gecersiz kalir.
SECRET_KEY=changeme
EMAIL_PEPPER_KEY=changemetoo
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Prod'da frontend origin'i yazilir, virgulle ayrilir. "*" sadece dev icindir.
ALLOWED_ORIGINS=*

HF_API_TOKEN=
HF_MODEL_URL=https://router.huggingface.co/hf-inference/models/unitary/toxic-bert

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=5
# Eszamanli CPU isini sinirlar, DB baglantisini degil.
THREADPOOL_TOKENS=40
# Ucustaki istek tavani (docker-entrypoint.sh). Asilirsa 503; tavansiz kalirsa asiri yukte
# DB havuzu tukenip 500 doner.
UVICORN_LIMIT_CONCURRENCY=32

# Reverse proxy'lerin IP'leri, virgulle ayrilir. Bos = X-Forwarded-For'a guvenilmez.
TRUSTED_PROXY_IPS=

# Rate limit'ler (slowapi sozdizimi). Olay aninda rebuild'siz kisilabilsin diye burada.
# AUTH; giris, kayit ve sifre sifirlama uclarina uygulanir.
RATE_LIMIT_DEFAULT=20/second;600/minute
RATE_LIMIT_AUTH=20/minute
# Yalnizca basarisiz girisler, IP basina. RATE_LIMIT_AUTH'tan dar olmali.
RATE_LIMIT_AUTH_FAILURES=10/minute
# Ayni sayacin e-posta ekseni; tek hesabi hedefleyen saldiri buna takilir.
RATE_LIMIT_AUTH_FAILURES_EMAIL=5/minute

# Cloudflare Transform Rule'unun X-Origin-Secret basligina koydugu deger.
# Bos = origin kilidi kapali. Dolduruldugunda Cloudflare'den gelmeyen istek 403 alir.
CF_ORIGIN_SECRET=
